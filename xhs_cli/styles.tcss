/* xhs-cli theme: Xiaohongshu red, simple, modern, compact */

Screen {
    background: $background;
}

/* All chrome uses Textual theme variables so GO > 切换主题 updates it live. */
TopBar {
    width: 100%;
    height: 1;
    background: $surface;
    padding: 0 1;
    color: $text;
}

.note-topbar {
    width: 100%;
    height: 1;
    background: $surface;
}

#note-back {
    width: auto;
    min-width: 0;
    height: 1;
    border: none;
    padding: 0 2;
    background: $surface;
    color: $text-muted;
    text-style: bold;
}

#note-back:hover,
#note-back:focus {
    background: $primary;
    color: $text;
}

.note-topbar-title {
    width: 1fr;
    height: 1;
    padding: 0 1;
    color: $text;
}

/* note header (fixed): title + author/meta */
#note-title {
    width: 100%;
    height: 1;
    padding: 0 1;
}

#note-meta {
    width: 100%;
    height: auto;
}

/* one-row bottom bar: mode badge + spinner + key hints */
BottomBar {
    dock: bottom;
    height: 1;
    background: $panel;
    padding: 0;
    color: $text-muted;
}

#bottom-mode,
#bottom-go,
.bottom-action {
    width: auto;
    min-width: 0;
    height: 1;
    border: none;
    padding: 0 2;
    margin: 0;
    color: $text;
    background: $panel;
}

#bottom-mode {
    text-style: bold;
}

#bottom-go {
    background: $primary;
    color: $text;
    text-style: bold;
}

#bottom-mode:hover,
#bottom-mode:focus,
#bottom-go:hover,
#bottom-go:focus,
.bottom-action:hover,
.bottom-action:focus {
    background: $surface-active;
    color: $text;
}

#bottom-status {
    width: auto;
    height: 1;
    color: $accent;
    text-style: bold;
}

#bottom-actions {
    width: auto;
    height: 1;
}

.bottom-fill {
    width: 1fr;
    height: 1;
}

/* bottom-bar loading spinner (only while busy) */
StatusLine {
    height: 1;
    padding: 0 1 0 0;
    color: $accent;
    text-style: bold;
}

/* feed top bar: tabs + right-aligned username */
.topbar {
    height: 1;
    background: $surface;
    padding: 0 1;
}

.tb-title {
    width: auto;
    height: 1;
    color: $text;
}

#tab-rec,
#tab-hot,
#tab-history {
    height: 1;
    border: none;
    min-width: 0;
    padding: 0 2;
    color: $text-muted;
}

.tab.tab-active {
    background: $primary;
    color: $text;
    text-style: bold;
}

.tb-user {
    width: 1fr;
    height: 1;
    text-align: right;
    color: $text-muted;
}

HistoryEntry {
    height: auto;
    margin: 0;
    padding: 0;
    background: $surface;
}

.history-heading,
.history-empty,
HistoryEndRule {
    height: auto;
    margin: 0;
}

.history-empty {
    margin: 0 1;
}

HistoryNoteRow {
    height: 1;
    margin: 0 1;
    padding: 0 1;
    color: $text;
    background: $surface;
}

HistoryNoteRow:hover,
HistoryNoteRow:focus {
    background: $boost;
    color: $accent;
    text-style: bold;
}

PageSearchBar {
    height: 1;
    width: 100%;
    background: $surface;
}

#page-search-input {
    height: 1;
    width: 1fr;
    border: none;
    padding: 0 1;
    background: $surface;
}

#page-search-status {
    height: 1;
    width: auto;
    min-width: 7;
    color: $text-muted;
    text-align: right;
}

.page-search-up,
.page-search-down,
.page-search-close {
    height: 1;
    width: auto;
    min-width: 0;
    border: none;
    padding: 0 2;
    background: $panel;
    color: $text;
}

#feed {
    height: 1fr;
}

.hint {
    margin: 1 2;
    color: $text-muted;
}

Card {
    height: auto;
    margin: 0 1;
    padding: 1 2;
    border: round $border;
    background: $surface;
}

Card:hover {
    background: $boost;
    border: round $accent;
}

Card:focus {
    border: round $primary;
    background: $primary-background;
}

/* list card with a 3:4 cover on the left */
.card-row {
    width: 100%;
    height: auto;
}

.card-thumb {
    width: 12;
    height: 8;
    margin: 0 1 0 0;
}

.card-text {
    width: 1fr;
    height: auto;
}

/* grid view: every card becomes an image cell */
FeedScroll.grid-mode {
    layout: grid;
    grid-rows: auto;
    grid-gutter: 1;
    padding: 0 1;
}

GridCard {
    height: auto;
    margin: 0;
    padding: 0 0 1 0;
    border: round $border;
    background: $surface;
}

GridCard:hover {
    border: round $accent;
}

GridCard:focus {
    border: round $primary;
    background: $primary-background;
}

.grid-thumb {
    width: 100%;
    height: auto;
}

.grid-title {
    width: 100%;
    height: auto;
    max-height: 2;
    padding: 0 1;
    text-style: bold;
}

.grid-meta {
    width: 100%;
    height: 1;
    padding: 0 1;
    color: $text-muted;
}

#content {
    height: 1fr;
}

NoteHeader {
    height: auto;
    max-height: 8;
    padding: 1 2 1 2;
    border-bottom: solid $border;
    background: $surface;
}

/* topic chips (#话题) */
.tag-row {
    height: 1;
    width: 100%;
    margin: 1 1 0 1;
}

.tagbtn {
    height: 1;
    min-width: 0;
    border: none;
    padding: 0 1;
    margin: 0 1 0 0;
    color: $accent;
    background: $boost;
    text-style: bold;
}

.tagbtn:hover,
.tagbtn:focus {
    background: $primary;
    color: $text;
}

/* photo gallery: inline preview + ‹ › controls */
.gallery {
    height: auto;
    margin: 1 0 0 0;
    align: left top;
}

.gallery-actions {
    width: 100%;
    height: 1;
    align: left middle;
}

.gallery-prev,
.gallery-next,
.gallery-zoom {
    height: 1;
    min-width: 0;
    border: none;
    padding: 0 2;
    margin: 0 0 0 2;
    color: $text;
    background: $boost;
}

.gallery-zoom {
    margin-left: 2;
}

.gallery-prev:hover,
.gallery-prev:focus,
.gallery-next:hover,
.gallery-next:focus,
.gallery-zoom:hover,
.gallery-zoom:focus {
    background: $primary;
    color: $text;
}

.gallery-prev:disabled,
.gallery-next:disabled {
    color: $text-muted;
}

.gallery-counter {
    width: auto;
    height: 1;
    padding: 0 1;
    color: $accent;
    text-style: bold;
}

.gallery-copy {
    width: 4;
    height: 1;
    min-width: 0;
    border: none;
    padding: 0;
    margin: 0 0 0 1;
    background: $boost;
    color: $text;
    content-align: center middle;
}

.gallery-copy:hover {
    background: $primary;
    color: $text;
}

.playbtn {
    height: 1;
    border: none;
    min-width: 0;
    text-align: left;
    content-align: left middle;
}

.title {
    margin: 0 1;
}

.meta {
    margin: 0 1;
    color: $text-muted;
}

.rule {
    color: $border;
    margin: 0 0 1 0;
}

.imgsec {
    height: auto;
    margin: 1 0 0 0;
    align: left top;
}

.img-inline {
    width: auto;
    height: auto;
    margin: 0 0 0 2;
}

.img-caption {
    width: 100%;
    height: auto;
    margin: 0 1 0 2;
    text-align: left;
    color: $text-muted;
}

.imgbtn {
    height: 1;
    border: none;
    min-width: 0;
    padding: 0 2;
    margin: 0 1 0 2;
    text-align: left;
    content-align: left middle;
}

/* copy-image button sitting right next to the image button (not right-aligned) */
.img-copy {
    width: 4;
    height: 1;
    min-width: 0;
    border: none;
    padding: 0;
    background: $boost;
    color: $text;
    content-align: center middle;
}

.img-copy:hover {
    background: $primary;
    color: $text;
}

.img-actions {
    width: 100%;
    height: 1;
    align: left middle;
}

.img-collapse {
    width: auto;
    min-width: 0;
    height: 1;
    border: none;
    padding: 0 2;
    margin: 0 1 0 2;
    color: $text-muted;
}

/* one-line "open link" buttons shown ahead of URLs */
.linkbtn {
    height: auto;
    min-height: 1;
    border: none;
    min-width: 0;
    padding: 0 2;
    margin: 1 1 0 1;
    text-align: left;
    content-align: left middle;
    color: $link-color;
    background: $link-background;
    text-style: underline;
}

/* 正文段落：内容区本身 0 边距（横线贯通到最左最右），文字距内容区左右各 2 字符 */
ClickableText {
    margin: 0 2;
}

/* cursor-mode highlight on link-bearing paragraphs */
ClickableText:focus {
    background: $primary-background;
}

.row {
    height: auto;
    margin: 1;
}

#open-web,
#end-next-note {
    height: 1;
    border: none;
    min-width: 0;
    text-align: left;
    content-align: left middle;
}

/* comments popup */
#cmt-panel {
    width: 100%;
    height: 100%;
    background: $panel;
    border: round $primary;
    padding: 1 1;
}

#cmt-title-row {
    height: 1;
    background: $panel;
}

/* title is the flexible element so the close button stays on-screen */
.cmt-head {
    width: 1fr;
    height: 1;
    padding: 0 1;
    text-style: bold;
}

.cmt-close {
    height: 1;
    border: none;
    min-width: 0;
    color: $accent;
}

.cmt-title {
    height: 1;
    background: $panel;
    padding: 0 1;
    text-style: bold;
}

#comments {
    height: 1fr;
    margin-top: 1;
}

.comment {
    margin: 0 1 0 1;
    padding: 1 0 1 0;
    border-bottom: solid $border;
}

.comment-reply {
    margin: 0 1 0 5;
    color: $text-muted;
}

/* URL / search prompt: a compact theme-native panel.  A single container
   avoids nested 100% widths overflowing through the right border. */
#prompt-panel {
    width: 72;
    max-width: 90%;
    height: 3;
    background: $surface;
    border: round $border;
    padding: 0 1;
    margin-top: 2;
}

.prompt-input {
    width: 1fr;
    min-width: 0;
    height: 1;
    min-height: 1;
    padding: 0 1;
    border: none;
    background: $panel;
    color: $text;
}

.prompt-input:focus {
    border: none;
    background: $panel;
    color: $text;
}

.prompt-btn {
    width: 4;
    height: 1;
    min-width: 0;
    border: none;
    padding: 0;
    color: $text;
    background: $primary;
    content-align: center middle;
}

.prompt-go {
    background: $primary;
    color: $text;
}

.prompt-go:hover,
.prompt-go:focus {
    background: $primary-lighten-1;
}

.prompt-cancel {
    background: $primary;
    color: $text;
}

.prompt-cancel:hover,
.prompt-cancel:focus {
    background: $error;
    color: $text;
}

SearchPromptScreen,
UrlPromptScreen {
    align: center top;
    padding: 0;
    overflow: hidden;
    background: $background 65%;
}

/* captcha / 风控 popup: one-line buttons */
VerificationRequiredScreen {
    align: center top;
    padding: 0;
    overflow: hidden;
    background: $background 65%;
}

#verify-panel {
    width: 84;
    max-width: 94%;
    height: auto;
    background: $surface;
    border: round $warning;
    padding: 1 2;
    margin-top: 3;
}

#verify-title {
    width: 100%;
    height: 1;
    color: $warning;
    text-style: bold;
}

#verify-message {
    width: 100%;
    height: auto;
    margin: 1 0;
    color: $text;
}

#verify-actions {
    width: 100%;
    height: 1;
    align: left middle;
}

.verify-btn {
    width: auto;
    min-width: 0;
    height: 1;
    border: none;
    padding: 0 2;
    margin: 0 2 0 0;
    background: $boost;
    color: $text;
}

.verify-btn:hover,
.verify-btn:focus {
    background: $accent;
    color: $text;
}

#verify-open {
    background: $primary;
    color: $text;
    text-style: bold;
}

#iviewer-hint {
    width: 100%;
    dock: top;
    height: 1;
    background: $panel;
    color: $text-muted;
    padding: 0 1;
}

#iviewer-stage {
    height: 1fr;
    width: 100%;
    align: center middle;
}

#iviewer-grid {
    width: auto;
    height: auto;
}

#iviewer-footer {
    dock: bottom;
    width: 100%;
    height: 1;
    background: $panel;
}

#iviewer-back {
    width: auto;
    min-width: 0;
    height: 1;
    border: none;
    padding: 0 2;
    background: $panel;
    color: $text;
}

#iviewer-back:hover,
#iviewer-back:focus {
    background: $primary;
}

#iviewer-caption {
    width: 1fr;
    height: 1;
    padding: 0 1;
    text-align: left;
    color: $text-muted;
}

#iviewer-status {
    width: auto;
    height: 1;
    padding: 0 1;
    text-align: right;
    color: $text-muted;
}
